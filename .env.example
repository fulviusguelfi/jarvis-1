# Copiar para .env e preencher

# --- Modo LLM ---
# "cloud" = Maritaca API (online)
# "local" = llama-server + Vulkan (offline, 100% local)
LLM_MODE=local

# --- LLM local ---
# Nome amigavel do modelo (informativo).
QWEN_MODEL=Qwen3-4B-Instruct-2507-UD-Q8_K_XL
# Binario: vazio = usa o padrao tools/llama.cpp/llama-server.exe.
LLAMA_SERVER_PATH=
# Caminho do .gguf (modelos sao grandes -> ficam fora do projeto, ex.: em A:\).
LLAMA_MODEL_PATH=A:\Qwen3-4B-Instruct-2507-UD-Q8_K_XL.gguf
# Tamanho do contexto (voz usa pouco).
LLAMA_CTX=16384

# Necessário apenas se LLM_MODE=cloud
# MARITACA_API_KEY=seu_token_aqui

# --- Conversacao fluida / turn-taking (Fase 1.6) — opcional, tem defaults ---
# Smart Turn v3 confirma "terminei de falar?" -> tolera pausa de pensamento.
# TURN_ENABLED=true
# TURN_THRESHOLD=0.5
# VAD_MIN_SILENCE_MS=800     # piso de silencio p/ fim de fala (era 500 = cortava)
# VAD_MAX_UTTERANCE_S=30     # teto de fala (era 10)
# VAD_HARD_SILENCE_MS=2500   # fallback duro: encerra mesmo sem confirmacao
# POST_TTS_SETTLE_MS=350     # espera pos-TTS antes de reabrir o mic (mata "Sim?" duplo)

# --- Modo TTS ---
# "piper" (recomendado — rápido, RTF ~0.06x)
# "kokoro" (mais natural, RTF ~0.38x)
# "qwen3" (melhor qualidade, mas lento — RTF ~9.6x)
TTS_MODE=piper
PIPER_VOICE=faber

# --- Áudio ---
# O Jarvis usa SEMPRE o dispositivo de entrada/saída padrão do Windows.
# Para trocar, mude o padrão em Configurações > Sistema > Som.
