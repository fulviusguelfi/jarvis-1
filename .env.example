# Copiar para .env e preencher

# --- Modo LLM ---
# "cloud" = Maritaca API (online, mais rápido no início)
# "local" = Qwen3-8B via llama-server + Vulkan (offline, 100% local)
LLM_MODE=local

# Necessário apenas se LLM_MODE=cloud
# MARITACA_API_KEY=seu_token_aqui

# --- Modo TTS ---
# "piper" (recomendado — rápido, RTF ~0.06x)
# "kokoro" (mais natural, RTF ~0.38x)
# "qwen3" (melhor qualidade, mas lento — RTF ~9.6x)
TTS_MODE=piper
PIPER_VOICE=faber

# --- Áudio (Windows com sounddevice) ---
# Use: python -c "import sounddevice; print(sounddevice.query_devices())"
# Anote os índices do seu headset Jabra (entrada e saída)
AUDIO_INPUT_DEVICE=-1
AUDIO_OUTPUT_DEVICE=-1
